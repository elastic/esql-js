{
  "name": "esql-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "check": "pnpm install && pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:antlr4": "pnpm --filter @elastic/esql-grammar run build:antlr4 && pnpm --filter @elastic/esql-promql-grammar run build:antlr4",
    "build:antlr4:esql": "pnpm --filter @elastic/esql-grammar run build:antlr4",
    "build:antlr4:promql": "pnpm --filter @elastic/esql-promql-grammar run build:antlr4",
    "sync:grammars": "./.buildkite/scripts/grammar_sync_local.sh",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm -r publish --access public --provenance --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@eslint/js": "10.0.1",
    "@lezer/common": "1.5.2",
    "@monaco-editor/react": "4.7.0",
    "@storybook/react-vite": "10.4.6",
    "@types/react": "19.2.17",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "monaco-editor": "0.55.1",
    "monaco-promql": "1.9.0",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.0.16"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
