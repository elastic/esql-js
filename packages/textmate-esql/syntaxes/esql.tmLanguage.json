{
  "name": "ES|QL",
  "scopeName": "source.esql",
  "fileTypes": [
    "esql"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string-triple"
    },
    {
      "include": "#string-double"
    },
    {
      "include": "#string-backtick"
    },
    {
      "include": "#pipe"
    },
    {
      "include": "#semicolon"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#source-command"
    },
    {
      "include": "#processing-command"
    },
    {
      "include": "#header-command"
    },
    {
      "include": "#option-keyword"
    },
    {
      "include": "#named-operator"
    },
    {
      "include": "#literal"
    },
    {
      "include": "#parameter"
    },
    {
      "include": "#type-cast"
    },
    {
      "include": "#time-interval"
    },
    {
      "include": "#number"
    },
    {
      "include": "#delimiter"
    },
    {
      "include": "#bracket"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.esql",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.esql"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.esql"
            }
          }
        },
        {
          "name": "comment.block.esql",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.esql"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.esql"
            }
          }
        },
        {
          "name": "comment.line.double-slash.esql",
          "match": "//.*$"
        }
      ]
    },
    "string-triple": {
      "name": "string.quoted.triple.esql",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.esql"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.esql"
        }
      }
    },
    "string-double": {
      "name": "string.quoted.double.esql",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.esql"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.esql"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.esql",
          "match": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        }
      ]
    },
    "string-backtick": {
      "name": "string.quoted.backtick.esql",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.esql"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.esql"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.esql",
          "match": "\\\\."
        }
      ]
    },
    "pipe": {
      "name": "keyword.operator.pipe.esql",
      "match": "\\|"
    },
    "semicolon": {
      "name": "punctuation.separator.semicolon.esql",
      "match": ";"
    },
    "function-call": {
      "match": "(?i)\\b(MV_MEDIAN_ABSOLUTE_DEVIATION|ST_SIMPLIFYPRESERVETOPOLOGY|TO_AGGREGATE_METRIC_DOUBLE|MEDIAN_ABSOLUTE_DEVIATION|COUNT_DISTINCT_OVER_TIME|TO_EXPONENTIAL_HISTOGRAM|MV_PSERIES_WEIGHTED_SUM|GREATER_THAN_OR_EQUAL|PERCENTILE_OVER_TIME|URL_ENCODE_COMPONENT|VARIANCE_OVER_TIME|LESS_THAN_OR_EQUAL|NETWORK_DIRECTION|PRESENT_OVER_TIME|TO_CARTESIANPOINT|TO_CARTESIANSHAPE|ABSENT_OVER_TIME|RANGE_INTERSECTS|ST_SYMDIFFERENCE|STDDEV_OVER_TIME|TO_UNSIGNED_LONG|COUNT_OVER_TIME|DATE_UNIT_COUNT|FIRST_OVER_TIME|MV_INTERSECTION|ST_CENTROID_AGG|ST_GEOMETRYTYPE|ST_INTERSECTION|TO_DENSE_VECTOR|TO_TIMEDURATION|COUNT_DISTINCT|LAST_OVER_TIME|RANGE_CONTAINS|TEXT_EMBEDDING|MATCH_OPERATOR|AVG_OVER_TIME|FIELD_EXTRACT|MAX_OVER_TIME|MIN_OVER_TIME|MV_DIFFERENCE|MV_INTERSECTS|MV_PERCENTILE|ST_DIFFERENCE|ST_EXTENT_AGG|ST_INTERSECTS|SUM_OVER_TIME|TO_DATE_NANOS|TO_DATEPERIOD|TO_DATE_RANGE|V_DOT_PRODUCT|DATE_EXTRACT|JSON_EXTRACT|MATCH_PHRASE|RANGE_WITHIN|ST_DIMENSION|TOP_SNIPPETS|WEIGHTED_AVG|GREATER_THAN|BYTE_LENGTH|DATE_FORMAT|FROM_BASE64|MV_CONTAINS|MV_IN_RANGE|ST_CONTAINS|ST_DISJOINT|ST_DISTANCE|ST_ENVELOPE|ST_SIMPLIFY|STARTS_WITH|TO_DATETIME|TO_GEOPOINT|TO_GEOSHAPE|V_MAGNITUDE|IS_NOT_NULL|BIT_LENGTH|CATEGORIZE|CIDR_MATCH|DATE_PARSE|DATE_TRUNC|MONTH_NAME|PERCENTILE|ST_GEOHASH|ST_GEOTILE|ST_ISEMPTY|ST_NPOINTS|TO_BOOLEAN|TO_COUNTER|TO_DEGREES|TO_GEOHASH|TO_GEOTILE|TO_INTEGER|TO_RADIANS|TO_TDIGEST|TO_VERSION|URL_DECODE|URL_ENCODE|NOT_EQUALS|CLAMP_MAX|CLAMP_MIN|COPY_SIGN|DATE_DIFF|EMBEDDING|ENDS_WITH|IP_PREFIX|MV_APPEND|MV_CONCAT|MV_DEDUPE|MV_MEDIAN|RANGE_MAX|RANGE_MIN|SPARKLINE|ST_BUFFER|ST_GEOHEX|ST_WITHIN|SUBSTRING|TO_BASE64|TO_DOUBLE|TO_GEOHEX|TO_STRING|V_HAMMING|V_L1_NORM|V_L2_NORM|LESS_THAN|NOT_RLIKE|COALESCE|CONTAINS|DAY_NAME|EARLIEST|GREATEST|INCREASE|MV_COUNT|MV_FIRST|MV_SLICE|MV_UNION|ROUND_TO|ST_UNION|TO_GAUGE|TO_LOWER|TO_RANGE|TO_UPPER|V_COSINE|VARIANCE|NOT_LIKE|MV_LAST|MV_SORT|PRESENT|REPLACE|REVERSE|ST_XMAX|ST_XMIN|ST_YMAX|ST_YMIN|STD_DEV|TBUCKET|TO_LONG|TO_TEXT|WITHOUT|IS_NULL|CHICKEN|ABSENT|BUCKET|CONCAT|IDELTA|LATEST|LENGTH|LOCATE|MEDIAN|MV_AVG|MV_MAX|MV_MIN|MV_SUM|MV_ZIP|REPEAT|SAMPLE|SHA256|SIGNUM|TRANGE|VALUES|EQUALS|NOT_IN|ACOSH|ASINH|ATAN2|ATANH|CHUNK|CLAMP|COUNT|DECAY|DELTA|DERIV|FIRST|FLOOR|HYPOT|IRATE|LEAST|LOG10|LTRIM|MATCH|RIGHT|ROUND|RTRIM|SCALB|SCORE|SPACE|SPLIT|TO_IP|TSTEP|RLIKE|DELAY|ACOS|ASIN|ATAN|CASE|CBRT|CEIL|COSH|HASH|LAST|LEFT|QSTR|RATE|SHA1|SINH|SQRT|ST_X|ST_Y|TANH|TRIM|CAST|LIKE|ABS|AVG|COS|EXP|KNN|KQL|LOG|MAX|MD5|MIN|NOW|POW|SIN|SUM|TAN|TAU|TOP|ADD|DIV|MOD|MUL|NEG|SUB|PI|IN|E)\\s*(\\()",
      "captures": {
        "1": {
          "name": "support.function.esql"
        },
        "2": {
          "name": "punctuation.bracket.round.begin.esql"
        }
      }
    },
    "source-command": {
      "name": "keyword.control.source.esql",
      "match": "(?i)\\b(?:SHOW\\s+INFO|EXPLAIN|PROMQL|FROM|SHOW|ROW|TS)\\b"
    },
    "processing-command": {
      "name": "keyword.control.processing.esql",
      "match": "(?i)\\b(?:REGISTERED_DOMAIN|CHANGE_POINT|METRICS_INFO|INLINESTATS|IP_LOCATION|LOOKUP\\s+JOIN|TS_COLLAPSE|COMPLETION|RIGHT\\s+JOIN|USER_AGENT|FULL\\s+JOIN|HIGHLIGHT|LEFT\\s+JOIN|MV_EXPAND|URI_PARTS|EXTERNAL|DISSECT|TS_INFO|ENRICH|INLINE|INSIST|LOOKUP|RENAME|RERANK|SAMPLE|DEDUP|LIMIT|STATS|WHERE|DROP|EVAL|FORK|FUSE|GROK|JOIN|KEEP|SORT|MMR)\\b"
    },
    "header-command": {
      "name": "keyword.control.header.esql",
      "match": "(?i)\\b(?:SET)\\b"
    },
    "option-keyword": {
      "name": "keyword.other.option.esql",
      "match": "(?i)\\b(?:METADATA|WHERE|SCORE|GROUP|LIMIT|WITH|KEY|BY|ON)\\b"
    },
    "named-operator": {
      "name": "keyword.operator.word.esql",
      "match": "(?i)\\b(?:RLIKE|FIRST|NULLS|LIKE|DESC|LAST|AND|NOT|ASC|OR|IS|IN|AS)\\b"
    },
    "literal": {
      "name": "constant.language.esql",
      "match": "(?i)\\b(?:FALSE|TRUE|NULL)\\b"
    },
    "parameter": {
      "patterns": [
        {
          "name": "variable.parameter.named.esql",
          "match": "\\?{1,9}[a-zA-Z_][a-zA-Z_0-9]*"
        },
        {
          "name": "variable.parameter.positional.esql",
          "match": "\\?{1,9}[0-9]+"
        },
        {
          "name": "variable.parameter.unnamed.esql",
          "match": "\\?{1,9}"
        }
      ]
    },
    "type-cast": {
      "name": "storage.type.esql",
      "match": "::\\w+\\b"
    },
    "time-interval": {
      "name": "constant.numeric.time.esql",
      "match": "(?i)\\b\\d+(_+\\d+)*\\s*(?:MILLISECONDS|MILLISECOND|QUARTERS|QUARTER|MINUTES|SECONDS|MONTHS|MINUTE|SECOND|YEARS|MONTH|WEEKS|HOURS|YEAR|WEEK|DAYS|HOUR|DAY|MIN|SEC|YR|MO|MS|Y|Q|W|D|H|M|S)\\b"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.esql",
          "match": "\\b\\d+(_+\\d+)*[eE][-+]?\\d+(_+\\d+)*\\b"
        },
        {
          "name": "constant.numeric.float.esql",
          "match": "\\b\\d*(_+\\d+)*\\.\\d+(_+\\d+)*([eE][-+]?\\d+(_+\\d+)*)?\\b"
        },
        {
          "name": "constant.numeric.integer.esql",
          "match": "\\b\\d+(_+\\d+)*\\b"
        }
      ]
    },
    "delimiter": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.esql",
          "match": "=~|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.esql",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.esql",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "punctuation.separator.comma.esql",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.esql",
          "match": "\\."
        }
      ]
    },
    "bracket": {
      "patterns": [
        {
          "match": "\\[",
          "name": "punctuation.bracket.square.begin.esql"
        },
        {
          "match": "\\]",
          "name": "punctuation.bracket.square.end.esql"
        },
        {
          "match": "\\(",
          "name": "punctuation.bracket.round.begin.esql"
        },
        {
          "match": "\\)",
          "name": "punctuation.bracket.round.end.esql"
        },
        {
          "match": "\\{",
          "name": "punctuation.bracket.curly.begin.esql"
        },
        {
          "match": "\\}",
          "name": "punctuation.bracket.curly.end.esql"
        }
      ]
    }
  }
}
