{
  "name": "@elastic/highlightjs-esql",
  "version": "4.22.0",
  "author": "Kibana ES|QL team",
  "description": "Highlight.js language syntax definitions for ES|QL",
  "license": "MIT",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "NOTICE.txt",
    "LICENSE.txt",
    "lib"
  ],
  "keywords": [
    "esql",
    "es|ql",
    "elastic",
    "highlight.js",
    "highlightjs",
    "syntax"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "https://github.com/elastic/esql-js.git",
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsup && tsc -p tsconfig.build.json",
    "build:watch": "tsup --watch --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@elastic/esql-definitions": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "highlight.js": "11.12.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
